{
  "name": "SERVER=FTP protocol scope uppercase for CONNECT mount",
  "args": [
    "SERVER=FTP",
    "MOUNT=\"connect://Example.COM:443/ tcp://tunnel.internal:2121 protocol=fTp priority=7\"",
    "PERMIT=FtP:Tunnel.Internal:198.51.100.7",
    "REJECT=FTP:Legacy.INTERNAL:*"
  ],
  "reference_config": {
    "servers": [
      {
        "name": "default",
        "protocol": "ftp",
        "listen": ":21"
      }
    ],
    "mounts": [
      {
        "source": "connect://example.com:443/",
        "target": "tcp://tunnel.internal:2121",
        "priority": 7,
        "protocol": "ftp"
      }
    ],
    "policies": [
      {
        "effect": "permit",
        "priority": 0,
        "source": "198.51.100.7",
        "protocol": "ftp",
        "destination": "tunnel.internal"
      },
      {
        "effect": "reject",
        "priority": -1,
        "source": "*",
        "protocol": "ftp",
        "destination": "legacy.internal"
      }
    ]
  }
}
